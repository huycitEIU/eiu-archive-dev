@startuml DeleteDocumentSequence
    autonumber
    actor "User" as user
    participant "Client (App/Web)" as client
    participant "Backend Server" as server
    database "Database" as db
    participant "File Storage Server" as fileStorage

    ' User xóa tài liệu
    user -> client: Chọn tài liệu & nhấn "Delete"
    activate client
    client --> user: Hiển thị hộp thoại xác nhận xóa
    alt Huỷ xoá
        user -> client: Nhấn "Cancel"
        client --> user: Hủy xóa, không thực hiện gì
    else Xác nhận xóa
        user -> client: Nhấn "Confirm"
        client -> server: DELETE /api/documents/delete/{document_id}
        activate server
        server -> db: Xóa thông tin tài liệu khỏi cơ sở dữ liệu (document_id)
        activate db
        db --> server: Xóa thành công
        deactivate db
        server -> fileStorage: Xóa tệp khỏi File Storage Server (sử dụng đường dẫn tệp)
        activate fileStorage
        fileStorage --> server: Xóa thành công
        deactivate fileStorage
        server --> client: Trả về kết quả thành công (200 OK)
        client --> user: Hiển thị "Xóa thành công"
        deactivate server
    end
@enduml