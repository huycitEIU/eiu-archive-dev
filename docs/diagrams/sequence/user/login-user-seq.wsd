@startuml LoginAccountSequence
    autonumber
    actor "User" as user
    participant "Client (App/Web)" as client
    participant "Backend Server" as server
    database "Database" as db

    ' User đăng nhập tài khoản
    user -> client: Nhập thông tin đăng nhập & nhấn "Sign in"
    activate client
    client -> server: POST /api/auth/login
    activate server
    server -> db: Kiểm tra thông tin đăng nhập
    activate db
    alt Thông tin đăng nhập hợp lệ
        db --> server: Thông tin hợp lệ
        server --> client: Trả về kết quả thành công + Token
        client --> user: Lưu token vào localStorage
    else Thông tin đăng nhập không hợp lệ
        db --> server: Thông tin không hợp lệ
        deactivate db
        server --> client: Trả về lỗi
        deactivate server
        client --> user: Hiển thị thông báo lỗi
        deactivate client
    end

@enduml