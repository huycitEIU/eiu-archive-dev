@startuml LoginAccountSequence
    autonumber
    actor "User" as user
    participant "Client (App/Web)" as client
    participant "Backend Server" as server
    database "Database" as db

    ' User đăng nhập tài khoản
    user -> client: Nhập thông tin đăng nhập & nhấn "Login"
    activate client
    client -> server: POST /api/auth/login (chứa thông tin đăng nhập)
    activate server
    server -> db: Kiểm tra thông tin đăng nhập (email, password)
    activate db
    alt Thông tin đăng nhập hợp lệ
        db --> server: Thông tin hợp lệ
        server --> client: Trả về kết quả thành công (200 OK) + Token
        client --> user: Hiển thị "Đăng nhập thành công"
    else Thông tin đăng nhập không hợp lệ
        db --> server: Thông tin không hợp lệ (email không tồn tại, password sai)
        server --> client: Trả về lỗi (401 Unauthorized)
        client --> user: Hiển thị thông báo lỗi
    end
    deactivate db
    deactivate server
    deactivate client

@enduml